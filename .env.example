# Database connection string for PostgreSQL on Neon (use pooled connection URL for serverless/interactive transactions)
# e.g. postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-your-database-pooler.neon.tech/neondb?sslmode=require

# Separate database used only by Vitest integration tests
TEST_DATABASE_URL=postgresql://user:password@ep-your-test-database-pooler.neon.tech/neondb?sslmode=require

# JWT Secret for signing session cookies
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Initial seed passwords (defaults to 123 if not set)
INITIAL_OWNER_PASSWORD=owner_secure_password
INITIAL_STAFF_PASSWORD=staff_secure_password

# Port
PORT=3000
